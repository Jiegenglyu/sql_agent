# Copy this file to .env and replace every change-me value.
# .env is ignored by Git. Never commit real API keys, database passwords, or tokens.

# App
APP_NAME=sql-agent
APP_API_PREFIX=/api
APP_TIMEZONE=Asia/Shanghai
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
VITE_API_PREFIX=/api

# PostgreSQL demo container
POSTGRES_DB=circle_demo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-admin-password
POSTGRES_HOST_PORT=55432
POSTGRES_READONLY_USER=sql_agent_readonly
POSTGRES_READONLY_PASSWORD=change-me-readonly-password

# Backend PostgreSQL connection used by the app and MCP tools
DATABASE_URL=postgresql://sql_agent_readonly:change-me-readonly-password@localhost:55432/circle_demo
PG_MAX_ROWS=200
PG_STATEMENT_TIMEOUT_MS=5000
PG_SCHEMA_LIMIT=80
PG_SCHEMAS=

# Business rules search
BUSINESS_RULES_DIR=backend/business_rules
BUSINESS_RULE_MAX_FILE_BYTES=256000
BUSINESS_RULE_MAX_RESULTS=8
AGENT_VERBOSE_DEBUG=false
AGENT_DEBUG_LOG_PATH=logs/agent-debug.log

# OpenAI-compatible LLM provider
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=change-me-model-name
LLM_API_KEY=change-me-api-key
LLM_TIMEOUT_SECONDS=45

# Local tooling
UV_CACHE_DIR=.uv-cache
